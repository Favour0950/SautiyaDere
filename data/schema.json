{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SautiYaDereCaseRecord",
  "type": "object",
  "required": [
    "case_id",
    "created_at",
    "platform",
    "category",
    "driver_statement",
    "extracted_entities",
    "evidence_status",
    "status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^SYD-[0-9]{8}-[0-9]{4}$",
      "description": "Unique case identifier (e.g., SYD-20261030-1001)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "enum": ["UBER", "BOLT", "FARAS", "YEGO", "LITTLE_CAB", "OTHER"]
    },
    "category": {
      "type": "string",
      "enum": [
        "PAYMENT_EARNINGS_HOLD",
        "FRAUD_ACCUSATION",
        "SAFETY_INCIDENT",
        "CONDUCT_COMPLAINT",
        "ACCOUNT_INTEGRITY"
      ]
    },
    "driver_statement": {
      "type": "string",
      "minLength": 10,
      "description": "Raw or voice-transcribed narrative from the driver"
    },
    "redacted_statement": {
      "type": "string",
      "description": "Narrative sanitized by Microsoft Presidio (PII removed)"
    },
    "extracted_entities": {
      "type": "object",
      "properties": {
        "TRIP_ID": { "type": "string", "nullable": true },
        "MONEY": { "type": "array", "items": { "type": "string" } },
        "LOCATION": { "type": "array", "items": { "type": "string" } },
        "DATE_TIME": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_status": {
      "type": "object",
      "required": [
        "provided_required",
        "missing_required",
        "provided_optional"
      ],
      "properties": {
        "provided_required": { "type": "array", "items": { "type": "string" } },
        "missing_required": { "type": "array", "items": { "type": "string" } },
        "provided_optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "GAP_CHECK_PENDING",
        "APPEAL_GENERATED",
        "SUBMITTED_TAWU",
        "RESOLVED"
      ]
    }
  }
}
